{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "assessment_id",
    "correlation",
    "node_id",
    "goal_kind",
    "status",
    "reason_codes",
    "evidence_refs",
    "source_kind",
    "timebase",
    "evaluated_at_s",
    "algorithm",
    "input_sha256",
    "confidence",
    "surface_safety",
    "execution_authorized",
    "task_completed"
  ],
  "properties": {
    "contract_version": {
      "const": "landing_assessment_proposal_v0.1"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "correlation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mission_id",
        "request_id",
        "action_id",
        "trace_id"
      ],
      "properties": {
        "mission_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "request_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "action_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "trace_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "node_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "goal_kind": {
      "enum": [
        "scene_ground_contact",
        "unknown_surface"
      ]
    },
    "status": {
      "enum": [
        "unknown",
        "criteria_met",
        "criteria_not_met"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      }
    },
    "source_kind": {
      "enum": [
        "synthetic_replay",
        "normalized_runtime_snapshot"
      ]
    },
    "timebase": {
      "enum": [
        "unix_s",
        "simulation_s",
        "px4_boot_s"
      ]
    },
    "evaluated_at_s": {
      "type": "number",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "algorithm": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confidence": {
      "type": "null"
    },
    "surface_safety": {
      "const": "unknown"
    },
    "execution_authorized": {
      "const": false
    },
    "task_completed": {
      "const": false
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Offline landing evidence assessment, proposal v0.1"
}
